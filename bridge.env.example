# ============================================================
# Bridge Server v2 — Variables de Entorno (PLANTILLA)
# ============================================================
# 1. Copia este archivo a `bridge.env` (misma carpeta).
# 2. Rellena los valores reales.
# 3. `bridge.env` está en .gitignore: NUNCA se sube al repo.
#
# deploy_bridge_v2.py sube este contenido como .env a la VM
# Debian (el servicio systemd riva-bridge lo carga con
# EnvironmentFile).
# ============================================================

# API Key de NVIDIA (compartida para STT y TTS)
# Obtener/rotar en https://build.nvidia.com
NVIDIA_API_KEY=nvapi-XXXX

# Function ID de Parakeet 1.1B ASR (STT)
# https://build.nvidia.com → Parakeet → Try API → Python → "function-id"
STT_FUNCTION_ID=XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX

# Function ID de Magpie TTS Multilingual
# https://build.nvidia.com/nvidia/magpie-tts-multilingual → Try API → Python
TTS_FUNCTION_ID=XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX

# Voz para español (opciones: Diego=masculina, Camila=femenina)
TTS_VOICE=Magpie-Multilingual.ES-US.Diego
TTS_LANG=es-US
TTS_SAMPLE_RATE=16000

# --- LLM (Nemotron vía NVIDIA NIM REST) ---
# API key para el LLM. En este proyecto el LLM usa una key distinta a la de
# STT/TTS. Si se deja vacía, el bridge reutiliza NVIDIA_API_KEY.
LLM_API_KEY=nvapi-XXXX
LLM_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.6
# Mensajes de historial a conservar (user + assistant combinados)
LLM_MAX_HISTORY=10
# System prompt (una sola línea)
LLM_SYSTEM_PROMPT=Eres un asistente de voz doméstico inteligente. Responde siempre en español, de forma breve y natural (máximo 2 o 3 frases), ya que tu respuesta será reproducida por voz. No uses emojis ni formato markdown.
